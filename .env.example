# Frontend variables are embedded in the browser bundle. Never put credentials here.
# In development, leave VITE_API_BASE_URL empty to use the Vite /api proxy.
VITE_API_BASE_URL=
# The local dev server enables reservations by default; builds disable them by default.
VITE_RESERVATION_FLOW_ENABLED=

# Backend target used by the local Vite proxy.
# local backend:   http://localhost:8080
# testing backend: http://localhost:8081
VITE_DEV_PROXY_TARGET=http://localhost:8080
